# Tenant: AL-Muzzamal Hotel (restaurant POS). Sourced by install-production.sh and update.sh when TENANT=muzzamal.
# Same bench as MicroMax, its own site and database. Every value can be overridden from the command line.
SITE_NAME="${SITE_NAME:-muzzamal}"
APEX_DOMAIN="${APEX_DOMAIN:-micromaxonline.uk}"
# One level under the apex (Cloudflare's free certificate covers *.micromaxonline.uk only).
BACKEND_DOMAIN="${BACKEND_DOMAIN:-erp-muzzamal.${APEX_DOMAIN}}"   # Frappe desk / POS Awesome
FRONTEND_DOMAIN="${FRONTEND_DOMAIN:-muzzamal.${APEX_DOMAIN}}"     # React app + POS terminal
# Apps installed on this site, in install order. restaurant sets up the company, payment modes, counter
# and menu (bench --site muzzamal execute restaurant.setup.run ...); no micromax on a restaurant site.
SITE_APPS="${SITE_APPS:-erpnext payments posawesome mm_core restaurant}"
# Apps update.sh pulls from their repo and installs if missing (A0).
EXTRA_APPS_LIST="${EXTRA_APPS_LIST:-mm_core posawesome restaurant}"
# React app at FRONTEND_DOMAIN: the same build as MicroMax; its nginx block sends requests to site 'muzzamal'.
FRONTEND_REPO="${FRONTEND_REPO-https://github.com/maqmalak/react-frontend.git}"
FRONTEND_DIR="${FRONTEND_DIR:-/home/${FRAPPE_USER:-maqmalak}/react-frontend}"   # shared with micromax
# Real restaurant data — no daily demo data.
DEMO_DAILY_COMPANY="${DEMO_DAILY_COMPANY-}"

# Tenant: MicroMax ERP (spinning / export). Sourced by install-production.sh and update.sh
# when TENANT=micromax (the default). Every value can still be overridden from the command line.

SITE_NAME="${SITE_NAME:-demo}"
APEX_DOMAIN="${APEX_DOMAIN:-micromaxonline.uk}"
BACKEND_DOMAIN="${BACKEND_DOMAIN:-erpnext.${APEX_DOMAIN}}"   # Frappe desk
FRONTEND_DOMAIN="${FRONTEND_DOMAIN:-demo.${APEX_DOMAIN}}"    # React app

# Apps installed on this site, in install order (mm_core before micromax, which requires it).
SITE_APPS="${SITE_APPS:-erpnext payments hrms lms wiki telephony helpdesk insights crm whatsapp mm_core micromax}"

# Apps update.sh pulls from their repo and installs if missing (A0). Bench-wide apps that only need
# installing on the site (erpnext, crm...) don't belong here — A0 installs those without pulling them.
EXTRA_APPS_LIST="${EXTRA_APPS_LIST:-mm_core posawesome}"

# React frontend served at FRONTEND_DOMAIN.
FRONTEND_REPO="${FRONTEND_REPO-https://github.com/maqmalak/react-frontend.git}"
FRONTEND_DIR="${FRONTEND_DIR:-/home/${FRAPPE_USER:-maqmalak}/react-frontend}"

# Daily demo data (micromax.demo_daily, cron 23:00): the company it keeps current. Empty = off.
# update.sh A4 writes it to the site's config; DEMO_DAILY_RUN=1 also catches up the missing days at deploy.
DEMO_DAILY_COMPANY="${DEMO_DAILY_COMPANY-MicroMax Erp Pvt Ltd.}"

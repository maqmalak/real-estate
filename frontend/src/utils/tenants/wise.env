# Tenant: Wise (school). Sourced by install-production.sh and update.sh when TENANT=wise.
# Same bench as MicroMax, its own site and database. Every value can be overridden from the command line.

SITE_NAME="${SITE_NAME:-wise}"
APEX_DOMAIN="${APEX_DOMAIN:-micromaxonline.uk}"
# One level under the apex: Cloudflare's free certificate covers *.micromaxonline.uk only, so a
# two-level name (erp.wise.micromaxonline.uk) fails HTTPS when proxied.
BACKEND_DOMAIN="${BACKEND_DOMAIN:-erp-wise.${APEX_DOMAIN}}"   # Frappe desk
FRONTEND_DOMAIN="${FRONTEND_DOMAIN:-wise.${APEX_DOMAIN}}"     # public site / portal

# Apps installed on this site, in install order. education before nl_school (Junior-School requires it);
# mm_core last so its CRM Lead fields find the crm app installed.
SITE_APPS="${SITE_APPS:-erpnext hrms crm whatsapp education nl_school mm_core}"

# Apps update.sh pulls from their repo and installs if missing (A0).
EXTRA_APPS_LIST="${EXTRA_APPS_LIST:-mm_core education nl_school}"

# React app at FRONTEND_DOMAIN: the same build as MicroMax. The build names no site; wise's nginx block
# sends its requests to site 'wise', and the app shows only the tiles whose backend apps wise has.
# Set FRONTEND_REPO="" to serve FRONTEND_DOMAIN from the Frappe site instead (website, /edu-portal).
FRONTEND_REPO="${FRONTEND_REPO-https://github.com/maqmalak/react-frontend.git}"
FRONTEND_DIR="${FRONTEND_DIR:-/home/${FRAPPE_USER:-maqmalak}/react-frontend}"   # shared with micromax

# No daily demo data on the school site.
DEMO_DAILY_COMPANY="${DEMO_DAILY_COMPANY-}"

# === Frappe / ERPNext backend ===
# Same-origin when the frontend is served from the Frappe site (leave empty).
# For a standalone Vite dev server point this at the Frappe site URL.
VITE_FRAPPE_URL=http://localhost:8080

# Optional — enables the realtime/Socket.IO WebSocket for live updates.
VITE_ENABLE_SOCKET=true

# Frappe multi-site name (docker SITE_NAME). Used as Host header by the Vite proxy.
VITE_FRAPPE_SITE=frontend
